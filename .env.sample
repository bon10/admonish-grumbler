PYTHONPATH=/app
FLASK_DEBUG=true

# Flaskのセッション署名鍵。値を変えると既存のログインセッションはすべて無効になる
APP_SECRET_KEY="your-secret-key"

# MongoDB Atlasの接続文字列
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

GEMINI_API_KEY="your-gemini-api-key"
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="your-verified-sender@example.com"

# ログインできる唯一の利用者。ハッシュは `python scripts/generate_password_hash.py` で生成する
ADMIN_USERNAME="your-login-name"
ADMIN_PASSWORD_HASH="bcrypt-hash-of-your-password"

# 定期サマリー生成エンドポイントの呼び出し元を認証するトークン（16文字以上のランダム文字列）
CRON_SECRET="random-string-at-least-16-chars"

# アプリ内スケジューラで週次・月次サマリーを自動生成する。
# 常駐プロセスを持てるローカル環境専用。本番(Vercel)では設定しない
ENABLE_IN_PROCESS_SCHEDULER=true
